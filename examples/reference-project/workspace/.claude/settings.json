{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/gate.sh",
            "timeout": 180
          },
          {
            "type": "command",
            "command": ".claude/hooks/hotfix.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
