# One block per UNIT: a directory with its own toolchain. Any layout works —
# a single repo is one unit at ".", a monorepo has a unit per package, a
# workspace of repos has a unit per repo. Paths are relative to the harness
# root (the directory holding this .claude/).
#
#   path       directory of the unit ("." = the harness root)
#   exts       file extensions the unit's linter handles, space-separated
#   lint       lints ONE file; {file} becomes its absolute path. Runs in the unit.
#   typecheck  whole-unit compile/type check, run by the Stop hook. Runs in the unit.
#   install    installs dependencies; run in every fresh worktree.
#
# Omit a key the unit does not have. Commands may contain pipes and quotes.
# Examples for other stacks: references/stacks.md.

[__UNIT_NAME__]
path = __UNIT_PATH__
exts = __UNIT_EXTS__
lint = __UNIT_LINT__
typecheck = __UNIT_TYPECHECK__
install = __UNIT_INSTALL__
